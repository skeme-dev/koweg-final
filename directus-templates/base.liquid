{% comment %}
  Grundgeruest fuer alle System-Mails von Directus.

  Ersetzt api/src/services/mail/templates/base.liquid. Directus sucht Templates
  zuerst in EMAIL_TEMPLATES_PATH (Standard ./templates, im Container also
  /directus/templates) und faellt erst danach auf die mitgelieferten zurueck -
  eine namensgleiche Datei hier gewinnt.

  Verfuegbare Variablen (aus den Projekt-Einstellungen):
    projectName    Settings -> Projektname
    projectColor   Settings -> Projektfarbe
    projectLogo    vollstaendige URL, PUBLIC_URL/assets/<id> des Projektlogos
    projectUrl     Settings -> Projekt-URL
    html           gerenderter Inhalt, falls kein content-Block gesetzt ist

  Bloecke fuer die einzelnen Templates:
    preheader   Vorschautext in der Posteingangsliste (wichtig - ohne ihn
                zeigen Gmail und Apple Mail die erste Zeile des Fliesstexts)
    content     der eigentliche Text
    footer      optionale Zusatzzeile unter der Fusszeile

  Warum das Ganze eine Tabellenverschachtelung ist: Outlook rendert mit Word.
  Flexbox, Grid und externe Stylesheets fallen damit aus, Stile muessen inline
  stehen. Die mso-Kommentare sind Outlook-only und geben dem Layout dort die
  feste Breite, die es sonst nicht haelt.
{% endcomment %}
<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta name="robots" content="noindex,follow" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>{{ projectName }}</title>

    <style type="text/css">
      /*<![CDATA[*/
      body, table, td, a {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
        -webkit-font-smoothing: antialiased;
      }
      table, td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      table { border-collapse: collapse !important; }
      img {
        border: 0;
        height: auto;
        line-height: 100%;
        outline: none;
        text-decoration: none;
        -ms-interpolation-mode: bicubic;
      }
      body {
        height: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
      }

      /* iOS faerbt Telefonnummern und Adressen sonst eigenmaechtig ein. */
      a[x-apple-data-detectors] {
        color: inherit !important;
        text-decoration: none !important;
        font-size: inherit !important;
        font-family: inherit !important;
        font-weight: inherit !important;
        line-height: inherit !important;
      }

      body a { color: {{ projectColor }}; text-decoration: underline; }
      body p { color: #4b5563; margin: 0 0 16px; }

      h1 {
        font-size: 24px;
        line-height: 32px;
        color: #111827;
        font-weight: 700;
        margin: 0 0 16px;
      }

      hr {
        margin: 0;
        width: 100%;
        border-top: 1px solid #e5e7eb;
        border-bottom: none;
        border-left: none;
        border-right: none;
      }

      /* Hinweiskasten fuer Fristen und Sicherheitshinweise. */
      .note {
        background-color: #f9fafb;
        border-left: 3px solid {{ projectColor }};
        padding: 12px 16px;
        margin: 0 0 16px;
        font-size: 14px;
        line-height: 22px;
        color: #4b5563;
      }

      /* Ersatzlink fuer Clients, die Buttons abschneiden oder blockieren. */
      .fallback {
        font-size: 13px;
        line-height: 20px;
        color: #6b7280;
        word-break: break-all;
      }

      @media screen and (max-width: 600px) {
        .max-width { max-width: 100% !important; }
        #content { padding-top: 24px !important; padding-bottom: 24px !important; }
        h1 { font-size: 21px !important; line-height: 28px !important; }
      }

      /* Android zentriert sonst nicht korrekt. */
      div[style*="margin: 16px 0;"] { margin: 0 !important; }
      /*]]>*/
    </style>
  </head>

  <body
    style="-webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; height:100% !important; width:100% !important; margin:0 !important; padding:0 !important; background-color:#f3f4f6;"
    bgcolor="#f3f4f6"
  >
    <!-- Vorschautext: sichtbar in der Posteingangsliste, nicht in der Mail. -->
    <div
      style="display:none; font-size:1px; color:#f3f4f6; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden;"
    >
      {% block preheader %}{{ projectName }}{% endblock %}
      &nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
    </div>

    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse !important;">
      <tbody>
        <tr>
          <td align="center" valign="top" width="100%" bgcolor="#f3f4f6" style="background-color:#f3f4f6; padding:32px 16px;">

            <!--[if (gte mso 9)|(IE)]>
            <table role="presentation" align="center" border="0" cellspacing="0" cellpadding="0" width="600"><tr><td align="center" valign="top" width="600">
            <![endif]-->

            <table
              role="presentation"
              class="max-width"
              align="center"
              border="0"
              cellpadding="0"
              cellspacing="0"
              width="100%"
              style="border-collapse:collapse !important; max-width:600px;"
            >
              <tbody>

                <!-- Kopf: Logo auf weisser Kachel. Bewusst weiss hinterlegt,
                     damit ein dunkles Logo auch dann sichtbar bleibt, wenn ein
                     Client die Mail eigenmaechtig invertiert. -->
                <tr>
                  <td align="center" valign="middle" bgcolor="#ffffff" style="background-color:#ffffff; border-radius:12px 12px 0 0; padding:32px 32px 24px 32px;">
                    <a href="{{ projectUrl }}" target="_blank" rel="noopener" style="text-decoration:none; border:0;">
                      <img
                        src="{{ projectLogo }}?width=160&amp;format=png"
                        alt="{{ projectName }}"
                        width="73"
                        height="96"
                        border="0"
                        style="display:block; width:73px; height:96px; object-fit:contain; border:0; outline:none; text-decoration:none;"
                      />
                    </a>
                  </td>
                </tr>

                <!-- Farbige Trennlinie in der Projektfarbe. -->
                <tr>
                  <td bgcolor="#ffffff" style="background-color:#ffffff; padding:0 32px;">
                    <div style="height:3px; line-height:3px; font-size:3px; background-color:{{ projectColor }};">&nbsp;</div>
                  </td>
                </tr>

                <!-- Inhalt -->
                <tr>
                  <td
                    id="content"
                    align="left"
                    valign="top"
                    bgcolor="#ffffff"
                    style="
                      background-color:#ffffff;
                      padding:32px;
                      font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;
                      font-size:16px;
                      line-height:26px;
                      color:#111827;
                    "
                  >
                    {% block content %}{{ html }}{% endblock %}

                    <p style="margin:24px 0 0;">
                      Sportliche Gr&uuml;&szlig;e<br />
                      <strong style="color:#111827;">Dein {{ projectName }}</strong>
                    </p>
                  </td>
                </tr>

                <!-- Fusszeile -->
                <tr>
                  <td
                    align="left"
                    valign="top"
                    bgcolor="#ffffff"
                    style="background-color:#ffffff; border-radius:0 0 12px 12px; padding:0 32px 28px 32px;"
                  >
                    <hr style="margin:0 0 16px;" width="100%" />
                    <p
                      style="
                        margin:0;
                        font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;
                        font-size:13px;
                        line-height:20px;
                        color:#6b7280;
                      "
                    >
                      Diese E-Mail wurde automatisch von <strong style="color:#374151;">{{ projectName }}</strong> versendet.
                      Bitte antworte nicht darauf.{% if projectUrl != '' %}<br />
                      <a href="{{ projectUrl }}" target="_blank" rel="noopener" style="color:{{ projectColor }}; text-decoration:underline;">{{ projectUrl }}</a>{% endif %}
                      {% block footer %}{% endblock %}
                    </p>
                  </td>
                </tr>

              </tbody>
            </table>

            <!--[if (gte mso 9)|(IE)]>
            </td></tr></table>
            <![endif]-->

          </td>
        </tr>
      </tbody>
    </table>
  </body>
</html>
