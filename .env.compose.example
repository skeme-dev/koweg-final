# Variablen für docker-compose.yml (Coolify: Environment Variables des Stacks).
#
# Nicht hier eintragen: KEY, SECRET, ADMIN_PASSWORD, POSTGRES-User/Passwort.
# Die erzeugt Coolify selbst über die SERVICE_*-Platzhalter im Compose.
#
# ACHTUNG: KEY und SECRET sind Teil des Recovery-Materials. Ein Restore der
# Datenbank ist nur brauchbar, wenn Directus danach mit denselben Werten
# startet - sonst sind Sessions, Flow-Credentials und SSO-Konfiguration hin.
# In Coolify stehen sie unter Environment Variables; sichere sie zusätzlich im
# Passwortmanager, zusammen mit den S3-Zugangsdaten.

# --- Öffentliche URLs -------------------------------------------------------
# Beide werden beim Frontend-Build ins Bundle gebacken. Ändern sie sich, muss
# das Frontend neu gebaut werden - ein Neustart reicht nicht.
PUBLIC_DIRECTUS_URL=https://directus.skeme.dev
PUBLIC_SITE_URL=https://www.svkoweg.de

# --- Frontend ---------------------------------------------------------------
# Statischer Token des "Frontend Bot User" - nur Formular-Einreichungen.
PUBLIC_DIRECTUS_FORM_TOKEN=
PUBLIC_ENABLE_VISUAL_EDITING=false
PUBLIC_FALLBACK_IMAGE_ID=
DRAFT_MODE_SECRET=

# --- Directus ---------------------------------------------------------------
ADMIN_EMAIL=admin@svkoweg.de
POSTGRESQL_DATABASE=directus

# Redis-Cache. false lässt Änderungen sofort durchschlagen, true macht die API
# schneller. Bei true erscheinen Redaktionsänderungen erst nach CACHE_TTL -
# CACHE_AUTO_PURGE=true leert den Cache immerhin bei jeder Änderung über die API.
CACHE_ENABLED=false
CACHE_TTL=2m
CACHE_AUTO_PURGE=true

# --- Backup -----------------------------------------------------------------
# Statischer Token eines Admin-Users. Getrennt vom Frontend-Token halten, damit
# er einzeln zurückgezogen werden kann.
BACKUP_DIRECTUS_TOKEN=
BACKUP_CRON=0 3 * * *
TZ=Europe/Berlin

# Off-site-Kopie (S3, MinIO, Hetzner, R2). Dringend empfohlen: ohne das liegen
# die Backups auf derselben Maschine wie die Daten.
S3_ENABLED=false
S3_BUCKET=
S3_PREFIX=directus-backups
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=auto
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# WICHTIG beim Bauen des Backup-Images: die Postgres-Client-Version muss zur
# Server-Version passen. Der Stack fährt postgis:16 - also:
#
#   docker build --build-arg PG_MAJOR=16 -t directus-backup:latest .
#
# Mit dem Standardwert 17 laufen Backups zwar durch, der Restore scheitert
# aber an Direktiven, die Postgres 16 nicht kennt. `status` warnt davor.
